{
  "name": "inference-bridge",
  "version": "0.11.2",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "node scripts/package.mjs chrome",
    "package:firefox": "node scripts/package.mjs firefox",
    "dev:firefox": "npm run package:firefox && web-ext run --source-dir build/firefox --target firefox-desktop",
