    "lint:firefox": "npm run package:firefox && node scripts/lint-firefox.mjs"
  },
  "devDependencies": {
    "fake-indexeddb": "6.2.8",
    "jsdom": "26.1.0",
    "vitest": "^3.2.4",
    "web-ext": "^10.7.0"
  },
  "dependencies": {
    "dompurify": "3.4.17",
    "marked": "18.2.0"
  }
}
